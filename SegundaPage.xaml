<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.SegundaPage"
             Title = "Questão 1";>

 <Grid>
        <Image
            Source="fundoquiz.gif"
            Aspect="AspectFill"
            IsAnimationPlaying="True" />

        <Label
            Text="Questão 1/10"
            FontSize="24"
            TextColor="#D37F37"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Como funcionava a questão da coleta de impostos no Egito Antigo?"
                FontSize="20"
                TextColor="#E05F77"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <RadioButton
                x:Name="alt1"
                Content="A) Com joias, ouro e outras pedras preciosas."
                TextColor="#0047AB"
                GroupName="Resposta" />

            <RadioButton
                x:Name="alt2"
                Content="B) Os camponeses pagavam impostos com parte da sua produção."
                TextColor="#0047AB"
                GroupName="Resposta" />

            <RadioButton
                x:Name="alt3"
                Content="C) Com moedas"
                TextColor="#0047AB"
                GroupName="Resposta" />

            <RadioButton
                x:Name="alt4"
                Content="D) Todas as alternativas estão corretas"
                TextColor="#0047AB"
                GroupName="Resposta" />

            <Button
                Text="Confirmar"
                BackgroundColor="#C67F35"
                TextColor="White"
                Clicked="OnClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </Grid>


</ContentPage>
