
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.SegundaPage"
             Title="SegundaPage">

    <Grid>
        <Image
            Source="fundo.gif"
            Aspect="AspectFill"
            IsAnimationPlaying="True" />

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Questão 1/10"
                FontSize="24"
                TextColor="#FFBC1C"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Button
                Text="Avançar para terceira página"
                BackgroundColor="#C67F35"
                TextColor="White"
                Clicked="OnClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
