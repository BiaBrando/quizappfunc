<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.QuartaPage"
             Title="Questão 4">

    <Grid>
        <Image
            Source="fundo.gif"
            Aspect="AspectFill"
            IsAnimationPlaying="True" />

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Questão 3/10"
                FontSize="24"
                TextColor="#D37F37"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="A religião estava presente em vários aspectos da vida dos egípcios. A crença na vida após a morte, por exemplo, influenciava seus costumes e práticas. Isso pode ser observado:"
                FontSize="20"
                TextColor="#E05F77"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        <RadioButton x:Name="alt1"
    Content="A) na construção de túmulos e na preparação dos corpos para a vida após a morte."
    GroupName="Resposta" />

<RadioButton x:Name="alt2"
    Content="B) na ideia de que apenas o faraó poderia receber vida após a morte."
    GroupName="Resposta" />

<RadioButton x:Name="alt3"
    Content="C) no abandono dos templos, já que os egípcios davam prioridade aos túmulos."
    GroupName="Resposta" />

<RadioButton x:Name="alt4"
    Content="D) na substituição dos rituais religiosos por explicações baseadas apenas na ciência."
    GroupName="Resposta" />

<RadioButton x:Name="alt5"
    Content="E) na crença de que a vida após a morte dependia exclusivamente da riqueza de cada pessoa."
    GroupName="Resposta" />

            <Button
                Text="Confirmar"
                BackgroundColor="#C67F35"
                TextColor="White"
                Clicked="OnClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
