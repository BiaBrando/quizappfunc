<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.UltimaPage"
             Title="Resultado">

    <Grid>
        <Image Source="final.gif" Aspect="AspectFill" IsAnimationPlaying="True" />

        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            <Label Text="Quiz concluído!"
                   FontSize="32"
                   TextColor="#0047AB"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="ResultadoLabel"
                   FontSize="24"
                   TextColor="#4052D6"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Button Text="Jogar novamente"
                    BackgroundColor="#C67F35"
                    TextColor="White"
                    Clicked="OnJogarNovamente" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
