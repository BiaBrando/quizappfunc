<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.DecimaPage"
             Title="Questão 9">

    <Grid>
        <Image Source="fundo.gif" Aspect="AspectFill" IsAnimationPlaying="True" />

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
                <Label Text="Questão 9/10" FontSize="32" TextColor="#FFBC1C" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Selecione a alternativa incorreta sobre a civilização egípcia."
                       FontSize="20" TextColor="#E05F77" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <RadioButton x:Name="alt1" Content="A) As cheias do rio Nilo prejudicavam o calendário agrícola e a organização das atividades econômicas." GroupName="Resposta" />
                <RadioButton x:Name="alt2" Content="B) A sociedade egípcia possuía uma divisão hierárquica difícil de superar." GroupName="Resposta" />
                <RadioButton x:Name="alt3" Content="C) O comércio egípcio envolvia trocas com povos estrangeiros." GroupName="Resposta" />
                <RadioButton x:Name="alt4" Content="D) A construção das pirâmides exigia planejamento, organização de trabalhadores e conhecimentos matemáticos." GroupName="Resposta" />
                <RadioButton x:Name="alt5" Content="E) O uso do papiro permitiu substituir completamente os registros feitos em monumentos de pedra." GroupName="Resposta" />
                <Button Text="Confirmar / Próxima" Clicked="OnClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
