<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.QuintaPage"
             Title="Questão 4">

    <Grid>
        <Image
            Source="fundoquiz.gif"
            Aspect="AspectFill"
            IsAnimationPlaying="True" />

        <ScrollView>
            <VerticalStackLayout
                Padding="30"
                Spacing="20"
                VerticalOptions="Center">

                <Label
                    Text="Questão 4/10"
                    FontSize="24"
                    TextColor="#D37F37"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Em que período histórico o Egito foi conquistado pelos romanos, em 30 a.C.?"
                    FontSize="20"
                    TextColor="#E05F77"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <RadioButton x:Name="alt1"
                    Content="A) Antigo Império"
                    GroupName="Resposta" />

                <RadioButton x:Name="alt2"
                    Content="B) Médio Império"
                    GroupName="Resposta" />

                <RadioButton x:Name="alt3"
                    Content="C) Novo Império"
                    GroupName="Resposta" />

                <RadioButton x:Name="alt4"
                    Content="D) Período Ptolomaico"
                    GroupName="Resposta" />

                <RadioButton x:Name="alt5"
                    Content="E) Segundo Período Intermediário"
                    GroupName="Resposta" />

                <Button
                    Text="Confirmar / Próxima"
                    BackgroundColor="#C67F35"
                    TextColor="White"
                    Clicked="OnClicked"
                    HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
