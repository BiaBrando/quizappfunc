<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.QuintaPage"
             Title="QuintaPage">

    <Grid>
        <Image
            Source="fundo.gif"
            Aspect="AspectFill"
            IsAnimationPlaying="True" />

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Questão 4/10"
                FontSize="24"
                TextColor="#D37F37"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Em que periodo ocorreu a conquista romana do Egito, em 30 a.c.?"
                FontSize="20"
                TextColor="#E05F77"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <RadioButton Content="A) Antigo imperio"
                         GroupName="Resposta" />

            <RadioButton Content="B) Novo imperio"
                         GroupName="Resposta" />

            <RadioButton Content="C) Segundo periodo intermediario"
                         GroupName="Resposta" />

            <RadioButton Content="D) Periodo Ptolomaico"
                         GroupName="Resposta" />

            <RadioButton Content="E) Médio periodo."
                         GroupName="Resposta" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
