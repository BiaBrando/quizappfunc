<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.OitavaPage"
             Title="Questão 7">

    <Grid>
        <Image Source="fundoquiz.gif" Aspect="AspectFill" IsAnimationPlaying="True" />

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
                <Label Text="Questão 7/10" FontSize="32" TextColor="#FFBC1C" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Qual era a importância da cidade de Tebas durante o Novo Império egípcio?"
                       FontSize="20" TextColor="#E05F77" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <RadioButton x:Name="alt1" Content="A) Era um importante centro político e religioso." GroupName="Resposta" />
                <RadioButton x:Name="alt2" Content="B) Era o principal centro de comércio entre os egípcios e povos estrangeiros." GroupName="Resposta" />
                <RadioButton x:Name="alt3" Content="C) Foi o local onde Cleópatra estabeleceu sua dinastia." GroupName="Resposta" />
                <RadioButton x:Name="alt4" Content="D) Era uma cidade dedicada à agricultura e à mineração." GroupName="Resposta" />
                <RadioButton x:Name="alt5" Content="E) Foi a primeira capital do Egito unificado." GroupName="Resposta" />
                <Button Text="Confirmar / Próxima" Clicked="OnClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
