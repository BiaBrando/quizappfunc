<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.NonaPage"
             Title="Questão 8">

    <Grid>
        <Image Source="fundoquiz.gif" Aspect="AspectFill" IsAnimationPlaying="True" />

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
                <Label Text="Questão 8/10" FontSize="32" TextColor="#FFBC1C" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Qual foi a relação entre Júlio César e Cleópatra VII?"
                       FontSize="20" TextColor="#E05F77" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <RadioButton x:Name="alt1" Content="A) Júlio César ajudou Cleópatra a recuperar o trono egípcio." GroupName="Resposta" />
                <RadioButton x:Name="alt2" Content="B) Júlio César conquistou o Egito e depôs Cleópatra." GroupName="Resposta" />
                <RadioButton x:Name="alt3" Content="C) Cleópatra liderou uma guerra contra Júlio César." GroupName="Resposta" />
                <RadioButton x:Name="alt4" Content="D) Júlio César transformou o Egito em uma província romana durante seu reinado." GroupName="Resposta" />
                <RadioButton x:Name="alt5" Content="E) Júlio César nomeou Cleópatra como governante após conquistar Alexandria." GroupName="Resposta" />
                <Button Text="Confirmar / Próxima" Clicked="OnClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
