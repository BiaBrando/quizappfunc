<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.SetimaPage"
             Title="Questão 6">

    <Grid>
        <Image
            Source="fundo.gif"
            Aspect="AspectFill"
            IsAnimationPlaying="True" />

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Questão 6/10"
                FontSize="32"
                TextColor="#FFBC1C"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Cleópatra VII buscou associar sua imagem a qual deusa egípcia?"
                FontSize="20"
                TextColor="#E05F77"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <RadioButton x:Name="alt1"
                Content="A) Bastet, deusa dos gatos e da proteção."
                GroupName="Resposta" />

            <RadioButton x:Name="alt2"
                Content="B) Ísis, deusa da maternidade e magia."
                GroupName="Resposta" />

            <RadioButton x:Name="alt3"
                Content="C) Sekhmet, deusa da guerra e da cura."
                GroupName="Resposta" />

            <RadioButton x:Name="alt4"
                Content="D) Hathor, deusa do amor, da música e da alegria."
                GroupName="Resposta" />

            <RadioButton x:Name="alt5"
                Content="E) Neftis, deusa dos rios e da fertilidade."
                GroupName="Resposta" />

            <Button
                Text="Confirmar"
                Clicked="OnClicked" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
