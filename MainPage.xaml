<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="exNavigationPage.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

  <Image
      Source="fundo.gif"
      Aspect="AspectFill"
      IsAnimationPlaying="True" />

  <Label
      Text="Quiz sobre o Egito"
      FontSize="32"
      TextColor="#FFBC1C"
      FontAttributes="Bold"
     />

  <Button
      x:Name="BtnNextPage"
      Text="Começar o quiz" 
      BackgroundColor="#C67F35"
      Clicked="OnClicked"
      HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
